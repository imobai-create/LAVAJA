# LavaJá — variáveis de ambiente.
# Copie para .env no desenvolvimento local (o .env está no .gitignore).
# No Railway, cadastre em Variables. O app NÃO lê arquivo .env sozinho
# (sem dotenv): use `env $(cat .env | xargs) npm start` ou exporte na mão.

# --- Infra (o Railway injeta estas duas automaticamente) ---
# Porta HTTP. Em produção quem define é o Railway.
PORT=3000
# Postgres. Sem esta variável o app roda em MEMÓRIA (os dados somem ao reiniciar).
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Use "disable" só para um Postgres local sem TLS. Em produção deixe vazio.
PGSSL=

# --- Negócio ---
# Quantas vagas de fundador a pré-venda oferece.
FOUNDERS_LIMIT=80
# WhatsApp da operação, só dígitos com DDI. Exposto em /api/stats para o front montar o wa.me.
WHATSAPP_NUMERO=5537999999999

# --- Painel admin (/admin.html) ---
# Segredo do painel e das rotas /api/leads, /api/franquia-leads e /api/admin/resumo.
# Também é o sal do hash de IP dos leads (LGPD: o IP cru nunca é gravado).
# SEM esta variável as rotas admin respondem 503 — nunca liberam acesso.
# Gere um valor longo: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_TOKEN=troque-por-um-segredo-longo

# --- Ajustes finos (opcionais, todos têm padrão) ---
# Cache em memória do /api/stats, em ms.
CACHE_STATS_MS=15000
# Rate limit: janela em ms, máximo de POSTs por IP na janela e teto global na janela.
RATE_LIMIT_JANELA_MS=60000
RATE_LIMIT_POST=10
RATE_LIMIT_GLOBAL=600
# Intervalo da faxina do mapa de rate limit, em ms (evita vazamento de memória).
RATE_LIMIT_LIMPEZA_MS=120000
# Válvula temporária de migração: 1 permite <script> inline no CSP.
# Só enquanto o JS da landing não estiver todo em /assets. Deixe vazio em produção.
CSP_SCRIPT_INLINE=
